PORT=5050
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGO_DB=vell
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=vell
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
CLIENT_ORIGINS=https://adminsilkofheaven.vercel.app,http://localhost:5173,http://localhost:5174,http://localhost:4173

# AI try-on (optional). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Website face swap: free local Python service (face-service/) first, Gemini as fallback
FACE_ENGINE=auto
FACE_SERVICE_URL=http://127.0.0.1:5065
# Same secret as on the deployed face service (leave empty for local use)
FACE_SERVICE_TOKEN=
# Face swaps allowed per visitor IP per hour
FACE_SWAP_PER_HOUR=20

# ---- Shop: links in emails ----
SITE_URL=https://your-website.vercel.app
ADMIN_URL=https://your-admin.vercel.app
STORE_NAME=Silk of Heaven

# ---- Razorpay (dashboard → Account & Settings → API keys). Test keys start with rzp_test_ ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook (dashboard → Webhooks → URL <API>/api/public/payments/razorpay-webhook, events payment.captured + order.paid)
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (order confirmations, password resets). Gmail: use an App password ----
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
STORE_NOTIFY_EMAIL=

# ---- SMS OTP login (SMSGatewayHub, DLT approved sender + template) ----
SMS_GH_API_KEY=
SMS_GH_SENDER_ID=
SMS_GH_ENTITY_ID=
SMS_GH_DLT_TEMPLATE_ID=
SMS_GH_ROUTE=
SMS_GH_OTP_TEXT=Your OTP is {{otp}}

# ---- Google login: Firebase project id only (tokens are checked with Google's public keys) ----
FIREBASE_PROJECT_ID=

# Browser push notifications (Web Push). Make a key pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key is sent to the website by the API; keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
